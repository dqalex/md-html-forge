{
  "name": "md-html-forge",
  "version": "0.2.0",
  "description": "Markdown → styled HTML rendering engine with 30+ built-in components, theme system, and slot-based template sync.",
  "keywords": [
    "markdown",
    "html",
    "renderer",
    "component",
    "template",
    "editorial",
    "design-system",
    "forge"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.js"
      },
      "require": {
        "types": "./dist/compiler/index.d.cts",
        "default": "./dist/compiler/index.cjs"
      }
    },
    "./slots": {
      "import": {
        "types": "./dist/lib/markdown-slots/index.d.ts",
        "default": "./dist/lib/markdown-slots/index.js"
      },
      "require": {
        "types": "./dist/lib/markdown-slots/index.d.cts",
        "default": "./dist/lib/markdown-slots/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.mjs"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/bootstrap.ts",
    "**/bootstrap-data-only.ts",
    "**/bootstrap.js",
    "**/icon-render.ts"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:lib": "npm run build:lib:prep && tsup && npm run build:lib:clean",
    "build:lib:prep": "node --import tsx scripts/build-forge-md.ts",
    "build:lib:clean": "node --import tsx scripts/clean-forge-md.ts",
    "build:lib:dry": "npm run build:lib:prep && tsup --dry-run && npm run build:lib:clean",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc --noEmit -p tsconfig.lib.json",
    "audit:templates": "node --require ./scripts/compile-templates/raw-require.cjs --import tsx scripts/compile-templates/run.ts",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.40.0",
    "@uiw/react-codemirror": "^4.25.8",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "html-to-image": "^1.11.13",
    "lucide-react": ">=0.300.0",
    "next": "^15.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^1.3.0",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
