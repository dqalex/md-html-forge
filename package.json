{
  "name": "md-html-forge",
  "version": "0.1.0",
  "private": true,
  "description": "A Markdown → styled HTML playground. Pipe markdown into slot-based HTML templates inspired by the html-effectiveness project, with teamclaw's editorial design language.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:templates": "node --require ./scripts/compile-templates/raw-require.cjs --import tsx scripts/compile-templates/run.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.40.0",
    "@uiw/react-codemirror": "^4.25.8",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.565.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^1.3.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
